# Wavdrop release-signing template (WD-06) — SAFE TO COMMIT.
#
# This file documents the keys the release build looks for. It contains NO real
# values. To sign a release locally:
#
#   1. Copy this file to  keystore.properties  (that name is gitignored).
#   2. Fill in the real values pointing at your UPLOAD key (not the final app key —
#      Google Play App Signing owns the final key once enrolled).
#   3. Keep the .jks / keystore file OUTSIDE the repository, or rely on *.jks/*.keystore
#      being gitignored. Never commit the keystore or these passwords.
#
# CI alternative: instead of this file, provide the matching environment variables
# (see below) as encrypted CI secrets. The Gradle config reads the file first, then
# falls back to the env vars, and only configures release signing when ALL are present.
# When none are supplied, the release build stays UNSIGNED.

# Path to the upload keystore, relative to the repository root (or absolute).
# Env var: WAVDROP_UPLOAD_STORE_FILE
storeFile=upload-keystore.jks

# Password for the keystore file.
# Env var: WAVDROP_UPLOAD_STORE_PASSWORD
storePassword=CHANGES_ME

# Alias of the upload key entry inside the keystore.
# Env var: WAVDROP_UPLOAD_KEY_ALIAS
keyAlias=wavdrop-upload

# Password for the key entry (often identical to storePassword).
# Env var: WAVDROP_UPLOAD_KEY_PASSWORD
keyPassword=CHANGES_ME
