<?xml version="1.0" encoding="utf-8"?>
<!-- Expanded (wavdrop_widget_expanded): height >= 330dp. Vertical card: centred artwork, centred title/artist, controls.
     FIXED parts (never squeezed): 16dp padding x2 + 128dp artwork + 4dp gap + 56dp controls = 220dp. WIDTH: controls 52+56+52 + 2x12 = 184dp <= 208dp (240 minimum - 32 padding).
     The title/artist block takes whatever remains (weight 1, 0dp): 110dp at the 330dp threshold versus ~93dp needed for a
     two-line title at 1.3x font scale (10 padding + 2*19sp*1.3*1.17 + 3 + 14sp*1.3*1.17). Larger font scales clip the TEXT, never
     the controls. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_body"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wavdrop_widget_loading_background"
    android:clipToOutline="true"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/widget_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#D916131F"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <ImageView
            android:id="@+id/widget_artwork"
            android:layout_width="128dp"
            android:layout_height="128dp"
            android:scaleType="centerCrop"
            android:background="@drawable/widget_artwork_bg"
            android:clipToOutline="true"
            android:contentDescription="@string/widget_artwork_desc" />

        <!-- Flexible text block: takes the remaining height and clips its own text if it ever overflows. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingTop="10dp">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="#F2EFF8"
                android:textSize="19sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center"
                android:textColor="#B5AFC6"
                android:textSize="14sp"
                android:maxLines="1"
                android:ellipsize="end" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:gravity="center">

            <ImageButton
                android:id="@+id/widget_previous"
                android:layout_width="52dp"
                android:layout_height="56dp"
                android:src="@drawable/widget_ic_skip_previous"
                android:background="@android:color/transparent"
                android:padding="14dp"
                android:contentDescription="@string/widget_prev_desc" />

            <ImageButton
                android:id="@+id/widget_play_pause"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="12dp"
                android:src="@drawable/widget_ic_play"
                android:background="@drawable/widget_btn_idle_bg"
                android:padding="14dp"
                android:contentDescription="@string/widget_play_pause_desc" />

            <ImageButton
                android:id="@+id/widget_next"
                android:layout_width="52dp"
                android:layout_height="56dp"
                android:layout_marginStart="12dp"
                android:src="@drawable/widget_ic_skip_next"
                android:background="@android:color/transparent"
                android:padding="14dp"
                android:contentDescription="@string/widget_next_desc" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
