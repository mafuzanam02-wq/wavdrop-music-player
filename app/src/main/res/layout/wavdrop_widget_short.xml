<?xml version="1.0" encoding="utf-8"?>
<!-- Compact strip (wavdrop_widget_short): height < 100dp or width < 220dp, i.e. below the declared 4x2 minimum
     (legacy bound widgets or unusual launcher cells). Artwork | title + artist | previous, play/pause, next. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_body"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wavdrop_widget_loading_background"
    android:clipToOutline="true"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/widget_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#D916131F"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="6dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <ImageView
            android:id="@+id/widget_artwork"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:scaleType="centerCrop"
            android:background="@drawable/widget_artwork_bg"
            android:clipToOutline="true"
            android:contentDescription="@string/widget_artwork_desc" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="4dp">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#F2EFF8"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#B5AFC6"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/widget_previous"
            android:layout_width="36dp"
            android:layout_height="40dp"
            android:src="@drawable/widget_ic_skip_previous"
            android:background="@android:color/transparent"
            android:padding="7dp"
            android:contentDescription="@string/widget_prev_desc" />

        <ImageButton
            android:id="@+id/widget_play_pause"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/widget_ic_play"
            android:background="@drawable/widget_btn_idle_bg"
            android:padding="9dp"
            android:contentDescription="@string/widget_play_pause_desc" />

        <ImageButton
            android:id="@+id/widget_next"
            android:layout_width="36dp"
            android:layout_height="40dp"
            android:src="@drawable/widget_ic_skip_next"
            android:background="@android:color/transparent"
            android:padding="7dp"
            android:contentDescription="@string/widget_next_desc" />

    </LinearLayout>

</FrameLayout>
